<?xml version="1.0" encoding="utf-8"?>
<!-- Spec 022 (CA-20) y spec 015 (R-16): nada de la app viaja en la copia en la
     nube ni al pasar los datos a otro teléfono (Android 12+): contactos de
     confianza, copias de visitas, borrador y almacenamiento seguro. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
